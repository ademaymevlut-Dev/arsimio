generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum SchoolStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum DomainStatus {
  PENDING
  VERIFIED
  FAILED
  DISABLED
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum RoleScope {
  PLATFORM
  SCHOOL
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum AuditSource {
  USER
  SYSTEM
  API
  IMPORT
}

enum AcademicYearStatus {
  DRAFT
  ACTIVE
  CLOSED
  ARCHIVED
}

enum AcademicTermStatus {
  DRAFT
  ACTIVE
  CLOSED
  ARCHIVED
}

model School {
  id              String       @id @default(uuid()) @db.Uuid
  slug            String       @unique @db.VarChar(80)
  name            String       @db.VarChar(200)
  legalName       String?      @map("legal_name") @db.VarChar(240)
  status          SchoolStatus @default(DRAFT)
  timezone        String       @default("UTC") @db.VarChar(100)
  defaultLocale   String       @default("tr") @map("default_locale") @db.VarChar(10)
  createdByUserId String?      @map("created_by_user_id") @db.Uuid
  archivedAt      DateTime?    @map("archived_at") @db.Timestamptz(6)
  archivedById    String?      @map("archived_by_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy                  User?                       @relation("SchoolCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  archivedBy                 User?                       @relation("SchoolArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)
  domains                    SchoolDomain[]
  branding                   SchoolBranding?
  memberships                SchoolMembership[]
  roles                      Role[]
  invitations                SchoolInvitation[]
  auditEvents                AuditEvent[]
  academicYears              AcademicYear[]
  academicTerms              AcademicTerm[]
  academicTermTranslations   AcademicTermTranslation[]
  educationStages            EducationStage[]
  educationStageTranslations EducationStageTranslation[]
  gradeLevels                GradeLevel[]
  classSections              ClassSection[]
  subjects                   Subject[]
  subjectTranslations        SubjectTranslation[]
  courseOfferings            CourseOffering[]
  lessonPeriods              LessonPeriod[]
  lessonPeriodTranslations   LessonPeriodTranslation[]

  @@index([status])
  @@map("schools")
}

model SchoolDomain {
  id            String       @id @default(uuid()) @db.Uuid
  schoolId      String       @map("school_id") @db.Uuid
  hostname      String       @unique @db.VarChar(253)
  status        DomainStatus @default(PENDING)
  isPrimary     Boolean      @default(false) @map("is_primary")
  verifiedAt    DateTime?    @map("verified_at") @db.Timestamptz(6)
  lastCheckedAt DateTime?    @map("last_checked_at") @db.Timestamptz(6)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  @@index([schoolId, status])
  @@map("school_domains")
}

model SchoolBranding {
  schoolId       String   @id @map("school_id") @db.Uuid
  logoAssetKey   String?  @map("logo_asset_key") @db.VarChar(500)
  iconAssetKey   String?  @map("icon_asset_key") @db.VarChar(500)
  primaryColor   String?  @map("primary_color") @db.VarChar(20)
  secondaryColor String?  @map("secondary_color") @db.VarChar(20)
  accentColor    String?  @map("accent_color") @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  @@map("school_branding")
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  authProvider       String?    @map("auth_provider") @db.VarChar(50)
  authProviderUserId String?    @map("auth_provider_user_id") @db.VarChar(191)
  email              String?    @unique @db.VarChar(320)
  firstName          String?    @map("first_name") @db.VarChar(100)
  lastName           String?    @map("last_name") @db.VarChar(100)
  status             UserStatus @default(PENDING)
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz(6)
  archivedAt         DateTime?  @map("archived_at") @db.Timestamptz(6)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  schoolsCreated          School[]           @relation("SchoolCreatedBy")
  schoolsArchived         School[]           @relation("SchoolArchivedBy")
  memberships             SchoolMembership[]
  platformRoles           UserRole[]
  invitationsSent         SchoolInvitation[] @relation("InvitationSender")
  invitationsAccepted     SchoolInvitation[] @relation("InvitationAcceptor")
  auditEvents             AuditEvent[]       @relation("AuditActor")
  membershipRolesAssigned MembershipRole[]   @relation("MembershipRoleAssigner")
  userRolesAssigned       UserRole[]         @relation("UserRoleAssigner")
  credential              UserCredential?
  sessions                AuthSession[]
  academicYearsCreated    AcademicYear[]     @relation("AcademicYearCreatedBy")
  academicYearsUpdated    AcademicYear[]     @relation("AcademicYearUpdatedBy")
  academicYearsArchived   AcademicYear[]     @relation("AcademicYearArchivedBy")
  academicTermsCreated    AcademicTerm[]     @relation("AcademicTermCreatedBy")
  academicTermsUpdated    AcademicTerm[]     @relation("AcademicTermUpdatedBy")
  academicTermsArchived   AcademicTerm[]     @relation("AcademicTermArchivedBy")

  @@unique([authProvider, authProviderUserId])
  @@index([status])
  @@map("users")
}

model SchoolMembership {
  id              String           @id @default(uuid()) @db.Uuid
  schoolId        String           @map("school_id") @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  username        String?          @db.VarChar(64)
  preferredLocale String?          @map("preferred_locale") @db.VarChar(10)
  status          MembershipStatus @default(INVITED)
  joinedAt        DateTime?        @map("joined_at") @db.Timestamptz(6)
  suspendedAt     DateTime?        @map("suspended_at") @db.Timestamptz(6)
  archivedAt      DateTime?        @map("archived_at") @db.Timestamptz(6)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  school      School           @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  user        User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  roles       MembershipRole[]
  auditEvents AuditEvent[]     @relation("AuditMembership")
  sessions    AuthSession[]

  @@unique([schoolId, userId])
  @@unique([schoolId, username])
  @@unique([id, schoolId])
  @@unique([id, schoolId, userId])
  @@index([schoolId, status])
  @@index([userId, status])
  @@map("school_memberships")
}

// Credentials are separate from profile records and must never be returned to UI/audit.
model UserCredential {
  userId       String   @id @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash") @db.VarChar(255)
  version      Int      @default(1)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("user_credentials")
}

model AuthSession {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash") @db.Char(64)
  hostname          String    @db.VarChar(253)
  schoolId          String?   @map("school_id") @db.Uuid
  membershipId      String?   @map("membership_id") @db.Uuid
  credentialVersion Int       @map("credential_version")
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user       User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  membership SchoolMembership? @relation(fields: [membershipId, schoolId, userId], references: [id, schoolId, userId], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model AuthThrottle {
  key      String   @id @db.Char(64)
  attempts Int
  resetAt  DateTime @map("reset_at") @db.Timestamptz(6)

  @@index([resetAt])
  @@map("auth_throttles")
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  schoolId    String?   @map("school_id") @db.Uuid
  key         String    @unique @db.VarChar(191)
  code        String    @db.VarChar(100)
  name        String    @db.VarChar(120)
  description String?   @db.VarChar(500)
  scope       RoleScope
  isSystem    Boolean   @default(false) @map("is_system")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  school          School?          @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  permissions     RolePermission[]
  membershipRoles MembershipRole[]
  userRoles       UserRole[]
  invitationRoles InvitationRole[]

  @@unique([schoolId, code])
  @@unique([id, schoolId])
  @@unique([id, scope])
  @@index([scope, isSystem])
  @@map("roles")
}

model Permission {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @unique @db.VarChar(191)
  scope       RoleScope
  description String?   @db.VarChar(500)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@unique([id, scope])
  @@map("permissions")
}

model RolePermission {
  roleId       String    @map("role_id") @db.Uuid
  permissionId String    @map("permission_id") @db.Uuid
  scope        RoleScope
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId, scope], references: [id, scope], onDelete: Cascade, onUpdate: Restrict)
  permission Permission @relation(fields: [permissionId, scope], references: [id, scope], onDelete: Restrict, onUpdate: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId, scope])
  @@map("role_permissions")
}

model MembershipRole {
  schoolId     String   @map("school_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  assignedById String?  @map("assigned_by_id") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  membership SchoolMembership @relation(fields: [membershipId, schoolId], references: [id, schoolId], onDelete: Cascade, onUpdate: Restrict)
  role       Role             @relation(fields: [roleId, schoolId], references: [id, schoolId], onDelete: Restrict, onUpdate: Restrict)
  assignedBy User?            @relation("MembershipRoleAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([membershipId, roleId])
  @@index([roleId])
  @@index([schoolId])
  @@map("membership_roles")
}

model UserRole {
  userId       String    @map("user_id") @db.Uuid
  roleId       String    @map("role_id") @db.Uuid
  roleScope    RoleScope @default(PLATFORM) @map("role_scope")
  assignedById String?   @map("assigned_by_id") @db.Uuid
  assignedAt   DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(6)

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role  @relation(fields: [roleId, roleScope], references: [id, scope], onDelete: Restrict, onUpdate: Restrict)
  assignedBy User? @relation("UserRoleAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model SchoolInvitation {
  id               String           @id @default(uuid()) @db.Uuid
  schoolId         String           @map("school_id") @db.Uuid
  email            String           @db.VarChar(320)
  tokenHash        String           @unique @map("token_hash") @db.VarChar(191)
  status           InvitationStatus @default(PENDING)
  invitedByUserId  String           @map("invited_by_user_id") @db.Uuid
  acceptedByUserId String?          @map("accepted_by_user_id") @db.Uuid
  expiresAt        DateTime         @map("expires_at") @db.Timestamptz(6)
  acceptedAt       DateTime?        @map("accepted_at") @db.Timestamptz(6)
  revokedAt        DateTime?        @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  school     School           @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  invitedBy  User             @relation("InvitationSender", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  acceptedBy User?            @relation("InvitationAcceptor", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  roles      InvitationRole[]

  @@unique([id, schoolId])
  @@index([schoolId, email, status])
  @@index([expiresAt, status])
  @@map("school_invitations")
}

model InvitationRole {
  schoolId     String @map("school_id") @db.Uuid
  invitationId String @map("invitation_id") @db.Uuid
  roleId       String @map("role_id") @db.Uuid

  invitation SchoolInvitation @relation(fields: [invitationId, schoolId], references: [id, schoolId], onDelete: Cascade, onUpdate: Restrict)
  role       Role             @relation(fields: [roleId, schoolId], references: [id, schoolId], onDelete: Restrict, onUpdate: Restrict)

  @@id([invitationId, roleId])
  @@index([roleId])
  @@index([schoolId])
  @@map("invitation_roles")
}

model AuditEvent {
  id                String      @id @default(uuid()) @db.Uuid
  schoolId          String?     @map("school_id") @db.Uuid
  actorUserId       String?     @map("actor_user_id") @db.Uuid
  actorMembershipId String?     @map("actor_membership_id") @db.Uuid
  source            AuditSource @default(USER)
  action            String      @db.VarChar(191)
  entityType        String      @map("entity_type") @db.VarChar(100)
  entityId          String?     @map("entity_id") @db.VarChar(191)
  beforeData        Json?       @map("before_data") @db.JsonB
  afterData         Json?       @map("after_data") @db.JsonB
  changedFields     Json?       @map("changed_fields") @db.JsonB
  reason            String?     @db.VarChar(1000)
  requestId         String?     @map("request_id") @db.VarChar(100)
  ipAddress         String?     @map("ip_address") @db.Inet
  userAgent         String?     @map("user_agent") @db.VarChar(500)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  school          School?           @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor           User?             @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actorMembership SchoolMembership? @relation("AuditMembership", fields: [actorMembershipId, schoolId, actorUserId], references: [id, schoolId, userId], onDelete: Restrict, onUpdate: Restrict)

  @@index([schoolId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([requestId])
  @@map("audit_events")
}

model AcademicYear {
  id           String             @id @default(uuid()) @db.Uuid
  schoolId     String             @map("school_id") @db.Uuid
  name         String             @db.VarChar(40)
  startDate    DateTime           @map("start_date") @db.Date
  endDate      DateTime           @map("end_date") @db.Date
  status       AcademicYearStatus @default(DRAFT)
  createdById  String?            @map("created_by_id") @db.Uuid
  updatedById  String?            @map("updated_by_id") @db.Uuid
  archivedAt   DateTime?          @map("archived_at") @db.Timestamptz(6)
  archivedById String?            @map("archived_by_id") @db.Uuid
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  school          School           @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy       User?            @relation("AcademicYearCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Restrict)
  updatedBy       User?            @relation("AcademicYearUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: Restrict)
  archivedBy      User?            @relation("AcademicYearArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull, onUpdate: Restrict)
  terms           AcademicTerm[]
  educationStages EducationStage[]
  gradeLevels     GradeLevel[]
  classSections   ClassSection[]
  courseOfferings CourseOffering[]
  lessonPeriods   LessonPeriod[]

  @@unique([schoolId, name])
  @@unique([id, schoolId])
  @@index([schoolId, status, startDate])
  @@map("academic_years")
}

model AcademicTerm {
  id             String             @id @default(uuid()) @db.Uuid
  schoolId       String             @map("school_id") @db.Uuid
  academicYearId String             @map("academic_year_id") @db.Uuid
  name           String             @db.VarChar(100)
  sequence       Int
  startDate      DateTime           @map("start_date") @db.Date
  endDate        DateTime           @map("end_date") @db.Date
  status         AcademicTermStatus @default(DRAFT)
  createdById    String?            @map("created_by_id") @db.Uuid
  updatedById    String?            @map("updated_by_id") @db.Uuid
  archivedAt     DateTime?          @map("archived_at") @db.Timestamptz(6)
  archivedById   String?            @map("archived_by_id") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  school       School                    @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  academicYear AcademicYear              @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Restrict, onUpdate: Restrict)
  createdBy    User?                     @relation("AcademicTermCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Restrict)
  updatedBy    User?                     @relation("AcademicTermUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: Restrict)
  archivedBy   User?                     @relation("AcademicTermArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull, onUpdate: Restrict)
  translations AcademicTermTranslation[]

  @@unique([academicYearId, sequence])
  @@unique([academicYearId, name])
  @@unique([id, schoolId])
  @@index([schoolId, status, startDate])
  @@index([academicYearId, status, sequence])
  @@map("academic_terms")
}

model AcademicTermTranslation {
  academicTermId String   @map("academic_term_id") @db.Uuid
  schoolId       String   @map("school_id") @db.Uuid
  locale         String   @db.VarChar(10)
  name           String   @db.VarChar(100)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  academicTerm AcademicTerm @relation(fields: [academicTermId, schoolId], references: [id, schoolId], onDelete: Restrict, onUpdate: Restrict)
  school       School       @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([academicTermId, locale])
  @@index([schoolId, locale])
  @@map("academic_term_translations")
}

model EducationStage {
  id             String    @id @default(uuid()) @db.Uuid
  schoolId       String    @map("school_id") @db.Uuid
  academicYearId String    @map("academic_year_id") @db.Uuid
  code           String    @db.VarChar(30)
  name           String    @db.VarChar(100)
  sequence       Int
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  school       School                      @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  academicYear AcademicYear                @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Restrict, onUpdate: Restrict)
  translations EducationStageTranslation[]
  gradeLevels  GradeLevel[]

  @@unique([academicYearId, code])
  @@unique([academicYearId, sequence])
  @@unique([id, schoolId, academicYearId])
  @@index([schoolId, academicYearId, archivedAt, sequence])
  @@map("education_stages")
}

model EducationStageTranslation {
  educationStageId String   @map("education_stage_id") @db.Uuid
  schoolId         String   @map("school_id") @db.Uuid
  academicYearId   String   @map("academic_year_id") @db.Uuid
  locale           String   @db.VarChar(10)
  name             String   @db.VarChar(100)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  educationStage EducationStage @relation(fields: [educationStageId, schoolId, academicYearId], references: [id, schoolId, academicYearId], onDelete: Restrict, onUpdate: Restrict)
  school         School         @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([educationStageId, locale])
  @@unique([schoolId, academicYearId, locale, name], map: "est_scope_locale_name_key")
  @@index([schoolId, academicYearId, locale], map: "est_scope_locale_idx")
  @@map("education_stage_translations")
}

model GradeLevel {
  id               String    @id @default(uuid()) @db.Uuid
  schoolId         String    @map("school_id") @db.Uuid
  academicYearId   String    @map("academic_year_id") @db.Uuid
  educationStageId String    @map("education_stage_id") @db.Uuid
  code             String    @db.VarChar(30)
  sequence         Int
  archivedAt       DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  school         School         @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  academicYear   AcademicYear   @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Restrict, onUpdate: Restrict)
  educationStage EducationStage @relation(fields: [educationStageId, schoolId, academicYearId], references: [id, schoolId, academicYearId], onDelete: Restrict, onUpdate: Restrict)
  classSections  ClassSection[]

  @@unique([academicYearId, code])
  @@unique([academicYearId, sequence])
  @@unique([id, schoolId, academicYearId])
  @@index([schoolId, academicYearId, educationStageId, archivedAt], map: "gl_scope_stage_archived_idx")
  @@map("grade_levels")
}

model ClassSection {
  id             String    @id @default(uuid()) @db.Uuid
  schoolId       String    @map("school_id") @db.Uuid
  academicYearId String    @map("academic_year_id") @db.Uuid
  gradeLevelId   String    @map("grade_level_id") @db.Uuid
  code           String    @db.VarChar(30)
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  school          School           @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  academicYear    AcademicYear     @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Restrict, onUpdate: Restrict)
  gradeLevel      GradeLevel       @relation(fields: [gradeLevelId, schoolId, academicYearId], references: [id, schoolId, academicYearId], onDelete: Restrict, onUpdate: Restrict)
  courseOfferings CourseOffering[]

  @@unique([academicYearId, gradeLevelId, code], map: "cs_year_grade_code_key")
  @@unique([id, schoolId, academicYearId])
  @@index([schoolId, academicYearId, archivedAt], map: "cs_scope_archived_idx")
  @@map("class_sections")
}

model Subject {
  id         String    @id @default(uuid()) @db.Uuid
  schoolId   String    @map("school_id") @db.Uuid
  name       String    @db.VarChar(150)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  school          School               @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  translations    SubjectTranslation[]
  courseOfferings CourseOffering[]

  @@unique([id, schoolId])
  @@index([schoolId, archivedAt, name])
  @@map("subjects")
}

model SubjectTranslation {
  subjectId String   @map("subject_id") @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  locale    String   @db.VarChar(10)
  name      String   @db.VarChar(150)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  subject Subject @relation(fields: [subjectId, schoolId], references: [id, schoolId], onDelete: Restrict, onUpdate: Restrict)
  school  School  @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([subjectId, locale])
  @@unique([schoolId, locale, name], map: "st_school_locale_name_key")
  @@index([schoolId, locale], map: "st_school_locale_idx")
  @@map("subject_translations")
}

model CourseOffering {
  id             String    @id @default(uuid()) @db.Uuid
  schoolId       String    @map("school_id") @db.Uuid
  academicYearId String    @map("academic_year_id") @db.Uuid
  classSectionId String    @map("class_section_id") @db.Uuid
  subjectId      String    @map("subject_id") @db.Uuid
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  academicYear AcademicYear @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Restrict, onUpdate: Restrict)
  classSection ClassSection @relation(fields: [classSectionId, schoolId, academicYearId], references: [id, schoolId, academicYearId], onDelete: Restrict, onUpdate: Restrict)
  subject      Subject      @relation(fields: [subjectId, schoolId], references: [id, schoolId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([academicYearId, classSectionId, subjectId], map: "co_year_section_subject_key")
  @@unique([id, schoolId])
  @@index([schoolId, academicYearId, archivedAt], map: "co_scope_archived_idx")
  @@index([subjectId, schoolId], map: "co_subject_school_idx")
  @@map("course_offerings")
}

model LessonPeriod {
  id             String    @id @default(uuid()) @db.Uuid
  schoolId       String    @map("school_id") @db.Uuid
  academicYearId String    @map("academic_year_id") @db.Uuid
  name           String    @db.VarChar(100)
  sequence       Int
  startTime      DateTime  @map("start_time") @db.Time(0)
  endTime        DateTime  @map("end_time") @db.Time(0)
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  school       School                    @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  academicYear AcademicYear              @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Restrict, onUpdate: Restrict)
  translations LessonPeriodTranslation[]

  @@unique([academicYearId, sequence])
  @@unique([id, schoolId, academicYearId])
  @@index([schoolId, academicYearId, archivedAt, startTime], map: "lp_scope_archived_start_idx")
  @@map("lesson_periods")
}

model LessonPeriodTranslation {
  lessonPeriodId String   @map("lesson_period_id") @db.Uuid
  schoolId       String   @map("school_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  locale         String   @db.VarChar(10)
  name           String   @db.VarChar(100)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  lessonPeriod LessonPeriod @relation(fields: [lessonPeriodId, schoolId, academicYearId], references: [id, schoolId, academicYearId], onDelete: Restrict, onUpdate: Restrict)
  school       School       @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([lessonPeriodId, locale])
  @@unique([schoolId, academicYearId, locale, name], map: "lpt_scope_locale_name_key")
  @@index([schoolId, academicYearId, locale], map: "lpt_scope_locale_idx")
  @@map("lesson_period_translations")
}
