  academicYearId                    String                       @map("academic_year_id") @db.Uuid
  responsibleGuardianRelationshipId String                       @map("responsible_guardian_relationship_id") @db.Uuid
  protocolNumber                    String                       @map("protocol_number") @db.VarChar(80)
  status                            StudentFinanceContractStatus @default(DRAFT)
  currencyCode                      String                       @default("EUR") @map("currency_code") @db.Char(3)
  issuedOn                          DateTime                     @default(dbgenerated("CURRENT_DATE")) @map("issued_on") @db.Date
  note                              String?                      @db.VarChar(1000)
  createdByUserId                   String?                      @map("created_by_user_id") @db.Uuid
  updatedByUserId                   String?                      @map("updated_by_user_id") @db.Uuid
  createdAt                         DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                         DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)

  school                          School                       @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  studentProfile                  StudentProfile               @relation(fields: [studentProfileId, schoolId], references: [id, schoolId], onDelete: Restrict, onUpdate: Restrict)
  academicYear                    AcademicYear                 @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Restrict, onUpdate: Restrict)
  responsibleGuardianRelationship GuardianRelationship         @relation(fields: [responsibleGuardianRelationshipId, schoolId, studentProfileId], references: [id, schoolId, studentProfileId], onDelete: Restrict, onUpdate: Restrict)
  items                           StudentFinanceContractItem[]
  installments                    StudentFinanceInstallment[]
  payments                        StudentFinancePayment[]

  @@unique([schoolId, academicYearId, protocolNumber], map: "sfc_school_year_protocol_key")
  @@unique([id, schoolId])
  @@index([schoolId, studentProfileId, academicYearId, status], map: "sfc_student_year_status_idx")
  @@index([schoolId, academicYearId, status], map: "sfc_year_status_idx")
  @@index([schoolId, responsibleGuardianRelationshipId], map: "sfc_responsible_guardian_idx")
  @@map("student_finance_contracts")
}

model StudentFinanceContractItem {
  id              String                           @id @default(uuid()) @db.Uuid
  schoolId        String                           @map("school_id") @db.Uuid
  contractId      String                           @map("contract_id") @db.Uuid
  kind            StudentFinanceContractItemKind
  description     String                           @db.VarChar(200)
  grossAmount     Decimal                          @map("gross_amount") @db.Decimal(12, 2)
  discountRate    Decimal                          @default(0) @map("discount_rate") @db.Decimal(5, 2)
  discountAmount  Decimal                          @default(0) @map("discount_amount") @db.Decimal(12, 2)
  netAmount       Decimal                          @map("net_amount") @db.Decimal(12, 2)
  status          StudentFinanceContractItemStatus @default(ACTIVE)
  sortOrder       Int                              @default(0) @map("sort_order")
  note            String?                          @db.VarChar(1000)
  createdByUserId String?                          @map("created_by_user_id") @db.Uuid
  updatedByUserId String?                          @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime                         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                         @updatedAt @map("updated_at") @db.Timestamptz(6)

  school   School                 @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  contract StudentFinanceContract @relation(fields: [contractId, schoolId], references: [id, schoolId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, schoolId])
  @@index([schoolId, contractId, status, sortOrder], map: "sfci_contract_status_order_idx")
  @@index([schoolId, kind, status], map: "sfci_kind_status_idx")
  @@map("student_finance_contract_items")
}

model StudentFinanceInstallment {
  id              String                          @id @default(uuid()) @db.Uuid
  schoolId        String                          @map("school_id") @db.Uuid
  contractId      String                          @map("contract_id") @db.Uuid
  kind            StudentFinanceInstallmentKind
  sequence        Int
  label           String                          @db.VarChar(80)
  dueDate         DateTime                        @map("due_date") @db.Date
  amount          Decimal                         @db.Decimal(12, 2)
  status          StudentFinanceInstallmentStatus @default(ACTIVE)
  note            String?                         @db.VarChar(1000)
  createdByUserId String?                         @map("created_by_user_id") @db.Uuid
  updatedByUserId String?                         @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                        @updatedAt @map("updated_at") @db.Timestamptz(6)

  school   School                 @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  contract StudentFinanceContract @relation(fields: [contractId, schoolId], references: [id, schoolId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([contractId, sequence], map: "sfi_contract_sequence_key")
  @@unique([id, schoolId])
  @@index([schoolId, contractId, status, sequence], map: "sfi_contract_status_sequence_idx")
  @@index([schoolId, dueDate, status], map: "sfi_due_status_idx")
  @@map("student_finance_installments")
}

model StudentFinancePayment {
  id              String                      @id @default(uuid()) @db.Uuid
  schoolId        String                      @map("school_id") @db.Uuid
  contractId      String                      @map("contract_id") @db.Uuid
  paidOn          DateTime                    @map("paid_on") @db.Date
  amount          Decimal                     @db.Decimal(12, 2)
  description     String                      @db.VarChar(300)
  status          StudentFinancePaymentStatus @default(ACTIVE)
  createdByUserId String?                     @map("created_by_user_id") @db.Uuid
  updatedByUserId String?                     @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)

  school   School                 @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  contract StudentFinanceContract @relation(fields: [contractId, schoolId], references: [id, schoolId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, schoolId])
  @@index([schoolId, contractId, status, paidOn], map: "sfp_contract_status_paid_on_idx")
  @@index([schoolId, paidOn, status], map: "sfp_paid_on_status_idx")
  @@map("student_finance_payments")
}

model Enrollment {
  id               String             @id @default(uuid()) @db.Uuid
  schoolId         String             @map("school_id") @db.Uuid
  studentProfileId String             @map("student_profile_id") @db.Uuid
  academicYearId   String             @map("academic_year_id") @db.Uuid
  status           EnrollmentStatus   @default(ACTIVE)
  enrolledOn       DateTime           @map("enrolled_on") @db.Date
  endedOn          DateTime?          @map("ended_on") @db.Date
  outcome          EnrollmentOutcome?
  outcomeOn        DateTime?          @map("outcome_on") @db.Date
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  school       School                  @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  student      StudentProfile          @relation(fields: [studentProfileId, schoolId], references: [id, schoolId], onDelete: Restrict, onUpdate: Restrict)
  academicYear AcademicYear            @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Restrict, onUpdate: Restrict)
  placements   StudentGroupPlacement[]

  @@unique([schoolId, studentProfileId, academicYearId])
  @@unique([id, schoolId, academicYearId])
  @@index([schoolId, academicYearId, status])
  @@map("enrollments")
}

model StudentGroupPlacement {
  id                         String    @id @default(uuid()) @db.Uuid
  schoolId                   String    @map("school_id") @db.Uuid
  academicYearId             String    @map("academic_year_id") @db.Uuid
  enrollmentId               String    @map("enrollment_id") @db.Uuid
  academicYearClassSectionId String    @map("academic_year_class_section_id") @db.Uuid
  validFrom                  DateTime  @map("valid_from") @db.Date
  validTo                    DateTime? @map("valid_to") @db.Date
  createdAt                  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  school                   School                   @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  academicYear             AcademicYear             @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Restrict, onUpdate: Restrict)
  enrollment               Enrollment               @relation(fields: [enrollmentId, schoolId, academicYearId], references: [id, schoolId, academicYearId], onDelete: Restrict, onUpdate: Restrict)
  academicYearClassSection AcademicYearClassSection @relation(fields: [academicYearClassSectionId, schoolId, academicYearId], references: [id, schoolId, academicYearId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([enrollmentId, validFrom])
  @@unique([id, schoolId])
  @@index([schoolId, academicYearId, academicYearClassSectionId, validFrom])
  @@map("student_group_placements")
}

model StudentLifecycleEvent {
  id               String                    @id @default(uuid()) @db.Uuid
  schoolId         String                    @map("school_id") @db.Uuid
  studentProfileId String                    @map("student_profile_id") @db.Uuid
  type             StudentLifecycleEventType
  effectiveOn      DateTime                  @map("effective_on") @db.Date
  exitReason       StudentExitReason?        @map("exit_reason")
  note             String?                   @db.VarChar(500)
  createdAt        DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)

  school  School         @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  student StudentProfile @relation(fields: [studentProfileId, schoolId], references: [id, schoolId], onDelete: Restrict, onUpdate: Restrict)

  @@index([schoolId, studentProfileId, effectiveOn])
  @@index([schoolId, type, exitReason, effectiveOn])
  @@map("student_lifecycle_events")
}
